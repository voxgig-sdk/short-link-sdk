# Entity: url_shortening

main: kit: entity: url_shortening: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "url_shortening"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://google.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/set/index.php"
          parts: [
            "api"
            "set"
            "index.php"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
